	filename: "living_world"
	group: ""
	icon: "minecraft:emerald"
	id: "1000000000000007"
	order_index: 6
	quest_links: []
	quests: [
		{description: ["Wallet and physical cash are two forms of one fixed Coin supply. Open /coins to see balance, backed cash, every denomination and Deposit/Withdraw actions."], icon: "jem_economy:copper_coin", id: "1100000000000007", tasks: [{id: "1110000000000007", item: {Count: 1b, id: "jem_economy:copper_coin"}, type: "item"}], title: "A Physical Coin", x: 0.0d, y: -1.0d},
		{dependencies: ["1100000000000007"], description: ["Spud shops keep real blocks and stock. JEM catalog purchases use the numeric Coin price, reserve funds, recheck stock, deliver the item, then credit the seller."], icon: "minecraft:emerald", id: "1100000000000017", tasks: [{id: "1110000000000017", type: "checkmark"}], title: "Trade Without a Faucet", x: 2.0d, y: -1.0d},
		{dependencies: ["1100000000000007"], description: ["Craft a Shipping Box from a chest surrounded by planks. It binds to your authenticated account, accepts only goods with both buy and sell prices, and pays backed physical Coins at 06:00."], icon: "jem_economy:shipping_box", id: "1100000000000047", tasks: [{id: "1110000000000047", item: {Count: 1b, id: "jem_economy:shipping_box"}, type: "item"}], title: "Shipping Box", x: 2.0d, y: -3.0d},
		{dependencies: ["1100000000000047"], description: ["Put an approved canonical stack into the input rows. Preview uses today's two demand groups; the dawn transaction re-quotes, consumes only accepted units and puts provenance-backed Coins in the payout row."], icon: "minecraft:wheat", id: "1100000000000057", tasks: [{id: "1110000000000057", type: "checkmark"}], title: "Ship Your First Box", x: 4.0d, y: -3.0d},
		{dependencies: ["1100000000000057"], description: ["Earn and collect at least one Silver Coin. Ten boxes still share one 80-Copper account cap; villager sales and public NPC orders use that same cap."], icon: "jem_economy:silver_coin", id: "1100000000000067", tasks: [{id: "1110000000000067", item: {Count: 1b, id: "jem_economy:silver_coin"}, type: "item"}], title: "Earn Your First Silver", x: 6.0d, y: -3.0d},
		{dependencies: ["1100000000000057"], description: ["Each market day selects two shared groups at 150% and 125%. Confirm one sale while a listed good is in demand; boosts never bypass account, world, item or funded-market limits."], icon: "minecraft:clock", id: "1100000000000077", tasks: [{id: "1110000000000077", type: "checkmark"}], title: "Market-Demand Day", x: 4.0d, y: -1.0d},
		{dependencies: ["1100000000000017"], description: ["Open a villager. Supported emerald offers appear in the Coin adapter only when the traded item has both prices. Unsupported or progression offers show no transaction and never yield an emerald backdoor."], icon: "minecraft:villager_spawn_egg", id: "1100000000000087", tasks: [{id: "1110000000000087", type: "checkmark"}], title: "Trade with a Villager", x: 4.0d, y: 0.0d},
		{description: ["Find a real bell and use it to open Town founding. Names must be unique; towns stay separated; creating one never creates a land claim."], icon: "minecraft:bell", id: "1100000000000027", tasks: [{id: "1110000000000027", item: {Count: 1b, id: "minecraft:bell"}, type: "item"}], title: "Town Hall Bell", x: 0.0d, y: 1.0d},
		{dependencies: ["1100000000000027"], description: ["Sneak-use the Town bell with a nearby loaded container to link physical supplies. Sneak-use while looking at an owned native Worker or Recruit to register Workforce."], icon: "minecraft:chest", id: "1100000000000037", tasks: [{id: "1110000000000037", item: {Count: 1b, id: "minecraft:chest"}, type: "item"}], title: "Supplies and Workforce", x: 2.0d, y: 1.0d}
	]
	title: "Living World"
}
