  "gui.cnc.field_guide_howler.label_line_5": "в темноте и",
  "gui.cnc.field_guide_howler.label_line_6": "ослепляют вас при",
  "gui.cnc.field_guide_howler.label_line_7": "первой возможности",
  "gui.cnc.field_guide_marmot.label_line_1": "Сурки — назойливые",
  "gui.cnc.field_guide_marmot.label_line_2": "грызуны, живущие",
  "gui.cnc.field_guide_marmot.label_line_3": "высоко в горах и",
  "gui.cnc.field_guide_marmot.label_line_4": "любящие луга. Они",
  "gui.cnc.field_guide_marmot.label_line_5": "спасаются от",
  "gui.cnc.field_guide_marmot.label_line_6": "хищников бегством и",
  "gui.cnc.field_guide_marmot.label_line_7": "обожают грызть",
  "gui.cnc.field_guide_marmot.label_line_8": "одуванчики",
  "gui.cnc.field_guide_marmot.label_line_9": "",
  "gui.cnc.field_guide_marmot.label_line_10": "",
  "gui.cnc.field_guide_mouse.label_line_1": "Мыши живут в лесах и",
  "gui.cnc.field_guide_mouse.label_line_2": "на равнинах. Быстро",
  "gui.cnc.field_guide_mouse.label_line_3": "убегают от любой",
  "gui.cnc.field_guide_mouse.label_line_4": "угрозы. Горшки",
  "gui.cnc.field_guide_mouse.label_line_5": "удобны для перевозки",
  "gui.cnc.field_guide_mouse.label_line_6": "этих малышей. Мыши",
  "gui.cnc.field_guide_mouse.label_line_7": "любят тыквенные",
  "gui.cnc.field_guide_mouse.label_line_8": "семечки",
  "gui.cnc.field_guide_mouse.label_line_9": "",
  "gui.cnc.field_guide_mouse.label_line_10": "",
  "gui.cnc.field_guide_pit_viper.label_line_1": "Ямкоголовые змеи",
  "gui.cnc.field_guide_pit_viper.label_line_2": "живут во влажных",
  "gui.cnc.field_guide_pit_viper.label_line_3": "лесах. Подходить к",
  "gui.cnc.field_guide_pit_viper.label_line_4": "ним смертельно",
  "gui.cnc.field_guide_pit_viper.label_line_5": "опасно! Их любимая",
  "gui.cnc.field_guide_pit_viper.label_line_6": "еда — сырая",
  "gui.cnc.field_guide_pit_viper.label_line_7": "крольчатина",
  "gui.cnc.field_guide_rattlesnake.label_line_1": "Гремучие змеи живут",
  "gui.cnc.field_guide_rattlesnake.label_line_2": "в сухих биомах,",
  "gui.cnc.field_guide_rattlesnake.label_line_3": "лесах и на равнинах.",
  "gui.cnc.field_guide_rattlesnake.label_line_4": "Опаснее обычных змей",
  "gui.cnc.field_guide_rattlesnake.label_line_5": "и могут укусить,",
  "gui.cnc.field_guide_rattlesnake.label_line_6": "если подойти близко!",
  "gui.cnc.field_guide_rattlesnake.label_line_7": "Любят сырую",
  "gui.cnc.field_guide_rattlesnake.label_line_8": "крольчатину",
  "gui.cnc.field_guide_rattlesnake.label_line_9": "",
  "gui.cnc.field_guide_rattlesnake.label_line_10": "",
  "gui.cnc.field_guide_ringtail.label_line_1": "Какомицли живут в",
  "gui.cnc.field_guide_ringtail.label_line_2": "сухих биомах. Они",
  "gui.cnc.field_guide_ringtail.label_line_3": "быстры, но если",
  "gui.cnc.field_guide_ringtail.label_line_4": "поймать и накормить",
  "gui.cnc.field_guide_ringtail.label_line_5": "светящимися ягодами,",
  "gui.cnc.field_guide_ringtail.label_line_6": "станут отличными",
  "gui.cnc.field_guide_ringtail.label_line_7": "спутниками в шахте",
  "gui.cnc.field_guide_ringtail.label_line_8": "",
  "gui.cnc.field_guide_ringtail.label_line_9": "",
  "gui.cnc.field_guide_sasquatch.label_line_1": "Сасквочи бродят по",
  "gui.cnc.field_guide_sasquatch.label_line_2": "лесам и мирны, пока",
  "gui.cnc.field_guide_sasquatch.label_line_3": "их не злят. Любят",
  "gui.cnc.field_guide_sasquatch.label_line_4": "стучать по деревьям",
  "gui.cnc.field_guide_sasquatch.label_line_5": "и незаметно",
  "gui.cnc.field_guide_sasquatch.label_line_6": "скрываются среди",
  "gui.cnc.field_guide_sasquatch.label_line_7": "стволов и теней",
  "gui.cnc.field_guide_sasquatch.label_line_8": "",
  "gui.cnc.field_guide_skinwalker.label_line_1": "Оборотни рыщут в",
  "gui.cnc.field_guide_skinwalker.label_line_2": "лесах и сухих",
  "gui.cnc.field_guide_skinwalker.label_line_3": "биомах. Обычно",
  "gui.cnc.field_guide_skinwalker.label_line_4": "маскируются под",
  "gui.cnc.field_guide_skinwalker.label_line_5": "лесных волков. Они",
  "gui.cnc.field_guide_skinwalker.label_line_6": "бросаются на вас с",
  "gui.cnc.field_guide_skinwalker.label_line_7": "криком. Фейерверки",
  "gui.cnc.field_guide_skinwalker.label_line_8": "очень действенны",
  "gui.cnc.field_guide_skinwalker.label_line_9": "против них",
  "gui.cnc.field_guide_skinwalker.label_line_10": "",
  "gui.cnc.field_guide_skunk.label_line_1": "Скунсы — вонючие, но",
  "gui.cnc.field_guide_skunk.label_line_2": "смелые лесные",
  "gui.cnc.field_guide_skunk.label_line_3": "всеядные одиночки.",
  "gui.cnc.field_guide_skunk.label_line_4": "Они не бегут от",
  "gui.cnc.field_guide_skunk.label_line_5": "хищника, а выпускают",
  "gui.cnc.field_guide_skunk.label_line_6": "едкий пар,",
  "gui.cnc.field_guide_skunk.label_line_7": "вызывающий тошноту.",
  "gui.cnc.field_guide_skunk.label_line_8": "Особенно любят яйца",
  "gui.cnc.field_guide_skunk.label_line_9": "",
  "gui.cnc.field_guide_skunk.label_line_10": "",
  "gui.cnc.field_guide_skunk.label_line_11": "",
  "gui.cnc.field_guide_snake.label_line_1": "Змеи живут в лесах и",
  "gui.cnc.field_guide_snake.label_line_2": "на равнинах. Они",
  "gui.cnc.field_guide_snake.label_line_3": "мирные и очень",
  "gui.cnc.field_guide_snake.label_line_4": "разнообразные.",
  "gui.cnc.field_guide_snake.label_line_5": "Обычно встречаются",
  "gui.cnc.field_guide_snake.label_line_6": "поодиночке. Любят",
  "gui.cnc.field_guide_snake.label_line_7": "перекусить сырой",
  "gui.cnc.field_guide_snake.label_line_8": "крольчатиной",
  "gui.cnc.field_guide_squonk.label_line_1": "Сквонки прячутся во",
  "gui.cnc.field_guide_squonk.label_line_2": "влажных биомах. Эти",
  "gui.cnc.field_guide_squonk.label_line_3": "несчастные звери",
  "gui.cnc.field_guide_squonk.label_line_4": "лишь плачут и бегут.",
  "gui.cnc.field_guide_squonk.label_line_5": "Не сочувствуйте им",
  "gui.cnc.field_guide_squonk.label_line_6": "слишком сильно: их",
  "gui.cnc.field_guide_squonk.label_line_7": "печаль поглотит вас,",
  "gui.cnc.field_guide_squonk.label_line_8": "и вы заплачете",
  "gui.cnc.field_guide_squonk.label_line_9": "вместе. За печенье",
  "gui.cnc.field_guide_squonk.label_line_10": "они дарят подарок",
  "gui.cnc.field_guide_squonk.label_line_11": "",
  "gui.cnc.field_guide_squonk.label_line_12": "",
  "gui.cnc.field_guide_squonk.label_line_13": "",
  "gui.cnc.field_guide_timber_wolf.label_line_1": "Лесные волки живут в",
  "gui.cnc.field_guide_timber_wolf.label_line_2": "лесах и охотятся",
  "gui.cnc.field_guide_timber_wolf.label_line_3": "стаями на вапити и",
  "gui.cnc.field_guide_timber_wolf.label_line_4": "белохвостых оленей.",
  "gui.cnc.field_guide_timber_wolf.label_line_5": "Также любят",
  "gui.cnc.field_guide_timber_wolf.label_line_6": "перекусить гнилой",
  "gui.cnc.field_guide_timber_wolf.label_line_7": "плотью",
  "gui.cnc.field_guide_timber_wolf.label_line_8": "",
  "gui.cnc.field_guide_turkey.label_line_1": "Индейки живут в",
  "gui.cnc.field_guide_turkey.label_line_2": "лесах и на равнинах.",
  "gui.cnc.field_guide_turkey.label_line_3": "Любят тыквенные",
  "gui.cnc.field_guide_turkey.label_line_4": "семечки и очень",
  "gui.cnc.field_guide_turkey.label_line_5": "боятся хищников.",
  "gui.cnc.field_guide_turkey.label_line_6": "Если поймаете одну",
  "gui.cnc.field_guide_turkey.label_line_7": "из этих птиц,",
  "gui.cnc.field_guide_turkey.label_line_8": "сможете приготовить",
  "gui.cnc.field_guide_turkey.label_line_9": "вкусный обед для",
  "gui.cnc.field_guide_turkey.label_line_10": "всей семьи",
  "gui.cnc.field_guide_turkey.label_line_11": "",
  "gui.cnc.field_guide_turkey.label_line_12": "",
  "gui.cnc.field_guide_wechuge.label_line_1": "Вечуге охотятся в",
  "gui.cnc.field_guide_wechuge.label_line_2": "лесах и холодных",
  "gui.cnc.field_guide_wechuge.label_line_3": "биомах. Воплощения",
  "gui.cnc.field_guide_wechuge.label_line_4": "мороза и зимы, они",
  "gui.cnc.field_guide_wechuge.label_line_5": "очень сильны и ловят",
  "gui.cnc.field_guide_wechuge.label_line_6": "жителей и дичь.",
  "gui.cnc.field_guide_wechuge.label_line_7": "Фейерверк оглушит",
  "gui.cnc.field_guide_wechuge.label_line_8": "их. В остальном —",
  "gui.cnc.field_guide_wechuge.label_line_9": "держитесь от них как",
  "gui.cnc.field_guide_wechuge.label_line_10": "можно дальше!",
  "gui.cnc.field_guide_wechuge.label_line_11": "",
  "gui.cnc.field_guide_wechuge.label_line_12": "",
  "gui.cnc.field_guide_wechuge.label_line_13": "",
  "gui.cnc.field_guide_wendigo.label_line_1": "Вендиго живут в",
  "gui.cnc.field_guide_wendigo.label_line_2": "лесах и холодных",
  "gui.cnc.field_guide_wendigo.label_line_3": "биомах. Охотятся на",
  "gui.cnc.field_guide_wendigo.label_line_4": "дичь и едят жителей.",
  "gui.cnc.field_guide_wendigo.label_line_5": "Крайне опасны.",
  "gui.cnc.field_guide_wendigo.label_line_6": "Фейерверки ненадолго",
  "gui.cnc.field_guide_wendigo.label_line_7": "останавливают их.",
  "gui.cnc.field_guide_wendigo.label_line_8": "Если фейерверков",
  "gui.cnc.field_guide_wendigo.label_line_9": "нет... бегите!",
  "gui.cnc.field_guide_wendigo.label_line_10": "",
  "gui.cnc.field_guide_wendigo.label_line_11": "",
  "gui.cnc.field_guide_wendigo.label_line_12": "",
  "gui.cnc.field_guide_wendigo.label_line_13": "",
  "gui.cnc.field_guide_white_tailed_deer.label_line_1": "Белохвостые олени",
  "gui.cnc.field_guide_white_tailed_deer.label_line_2": "живут в лесах и на",
  "gui.cnc.field_guide_white_tailed_deer.label_line_3": "равнинах. При атаке",
  "gui.cnc.field_guide_white_tailed_deer.label_line_4": "бегут и по",
  "gui.cnc.field_guide_white_tailed_deer.label_line_5": "возможности",
  "gui.cnc.field_guide_white_tailed_deer.label_line_6": "защищаются. Их",
  "gui.cnc.field_guide_white_tailed_deer.label_line_7": "оленина годится для",
  "gui.cnc.field_guide_white_tailed_deer.label_line_8": "множества сытных",
  "gui.cnc.field_guide_white_tailed_deer.label_line_9": "блюд. На досуге",
  "gui.cnc.field_guide_white_tailed_deer.label_line_10": "любят жевать пшеницу",
  "gui.cnc.field_guide_white_tailed_deer.label_line_11": "",
  "gui.cnc.field_guide_white_tailed_deer.label_line_12": "",
  "gui.cnc.field_guide_whitetail.label_line_1": "Белохвостые олени",
  "gui.cnc.field_guide_whitetail.label_line_2": "живут в лесах.",
  "gui.cnc.field_guide_whitetail.label_line_3": "Похожи на",
  "gui.cnc.field_guide_whitetail.label_line_4": "чернохвостых, но те",
  "gui.cnc.field_guide_whitetail.label_line_5": "предпочитают",
  "gui.cnc.field_guide_whitetail.label_line_6": "открытый сухой",
  "gui.cnc.field_guide_whitetail.label_line_7": "климат и имеют рога",
  "gui.cnc.field_guide_whitetail.label_line_8": "крупнее. Очень",
  "gui.cnc.field_guide_whitetail.label_line_9": "пугливы и бегут от",
  "gui.cnc.field_guide_whitetail.label_line_10": "хищников. Дают",
  "gui.cnc.field_guide_whitetail.label_line_11": "оленину, шкуру и",
  "gui.cnc.field_guide_whitetail.label_line_12": "рога. Любят",
  "gui.cnc.field_guide_whitetail.label_line_13": "перекусить",
  "gui.cnc.field_guide_whitetail_2.label_line_1": "пшеницей, пока сами не",
  "gui.cnc.field_guide_whitetail_2.label_line_2": "попали на обеденный стол",
  "gui.cnc.field_guide_wolverine.label_line_1": "Росомахи живут в",
  "gui.cnc.field_guide_wolverine.label_line_2": "холодных биомах.",
  "gui.cnc.field_guide_wolverine.label_line_3": "Невелики, но сильны.",
  "gui.cnc.field_guide_wolverine.label_line_4": "Охотятся на разную",
  "gui.cnc.field_guide_wolverine.label_line_5": "дичь и людей. Ещё",
  "gui.cnc.field_guide_wolverine.label_line_6": "любят сырую оленину",
  "gui.cnc.field_guide_wolverine.label_line_7": "",
  "gui.cnc.field_guide_wolverine.label_line_8": "",
  "gui.cnc.field_guide_wolverine.label_line_9": "",
