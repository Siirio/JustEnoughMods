  "gui.cnc.field_guide_beaver.label_line_9": "",
  "gui.cnc.field_guide_beaver.label_line_10": "",
  "gui.cnc.field_guide_black_bear.label_line_1": "Барибалы живут в",
  "gui.cnc.field_guide_black_bear.label_line_2": "лесах. Они не очень",
  "gui.cnc.field_guide_black_bear.label_line_3": "дружелюбны, но",
