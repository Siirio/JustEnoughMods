  "gui.cnc.field_guide_black_bear.label_line_5": "помогают их",
  "gui.cnc.field_guide_black_bear.label_line_6": "успокоить",
  "gui.cnc.field_guide_black_bear.label_line_7": "",
  "gui.cnc.field_guide_caribou.label_line_1": "Карибу живут в",
  "gui.cnc.field_guide_caribou.label_line_2": "холодных биомах и",
  "gui.cnc.field_guide_caribou.label_line_3": "глухой тайге.",
  "gui.cnc.field_guide_caribou.label_line_4": "Несмотря на",
  "gui.cnc.field_guide_caribou.label_line_5": "праздничный образ,",
  "gui.cnc.field_guide_caribou.label_line_6": "они грозно дают",
  "gui.cnc.field_guide_caribou.label_line_7": "отпор. Живут стадами",
  "gui.cnc.field_guide_caribou.label_line_8": "или поодиночке. Дают",
  "gui.cnc.field_guide_caribou.label_line_9": "оленину. Накормите",
  "gui.cnc.field_guide_caribou.label_line_10": "красными грибами и",
  "gui.cnc.field_guide_caribou.label_line_11": "оседлайте для езды",
  "gui.cnc.field_guide_caribou.label_line_12": "",
  "gui.cnc.field_guide_caribou.label_line_13": "",
  "gui.cnc.field_guide_chupacabra.label_line_1": "Чупакабры охотятся в",
  "gui.cnc.field_guide_chupacabra.label_line_2": "сухих биомах. Любят",
  "gui.cnc.field_guide_chupacabra.label_line_3": "есть ваш скот и вас",
  "gui.cnc.field_guide_chupacabra.label_line_4": "",
  "gui.cnc.field_guide_cougar.label_line_1": "Пумы живут в лесах и",
  "gui.cnc.field_guide_cougar.label_line_2": "сухих биомах. Эти",
  "gui.cnc.field_guide_cougar.label_line_3": "хищники могут",
  "gui.cnc.field_guide_cougar.label_line_4": "полюбить вас за",
  "gui.cnc.field_guide_cougar.label_line_5": "оленину. Обычно",
  "gui.cnc.field_guide_cougar.label_line_6": "живут поодиночке и",
  "gui.cnc.field_guide_cougar.label_line_7": "охотятся на любую",
  "gui.cnc.field_guide_cougar.label_line_8": "дичь",
  "gui.cnc.field_guide_cougar.label_line_9": "",
  "gui.cnc.field_guide_cougar.label_line_10": "",
  "gui.cnc.field_guide_cougar.label_line_11": "",
  "gui.cnc.field_guide_coyote.label_line_1": "Койоты живут в лесах",
  "gui.cnc.field_guide_coyote.label_line_2": "и сухих биомах.",
  "gui.cnc.field_guide_coyote.label_line_3": "Охотятся большими",
  "gui.cnc.field_guide_coyote.label_line_4": "стаями, ведь вместе",
  "gui.cnc.field_guide_coyote.label_line_5": "они сильнее. Ловят",
  "gui.cnc.field_guide_coyote.label_line_6": "дичь и скот. Также",
  "gui.cnc.field_guide_coyote.label_line_7": "любят гнилую плоть",
  "gui.cnc.field_guide_coyote.label_line_8": "",
  "gui.cnc.field_guide_coyote.label_line_9": "",
  "gui.cnc.field_guide_coyote.label_line_10": "",
  "gui.cnc.field_guide_coyote.label_line_11": "",
  "gui.cnc.field_guide_elk.label_line_1": "Вапити живут в лесах",
  "gui.cnc.field_guide_elk.label_line_2": "и на равнинах. Это",
  "gui.cnc.field_guide_elk.label_line_3": "грозные звери: при",
  "gui.cnc.field_guide_elk.label_line_4": "угрозе они яростно",
  "gui.cnc.field_guide_elk.label_line_5": "защищаются.",
  "gui.cnc.field_guide_elk.label_line_6": "Встречаются группами",
  "gui.cnc.field_guide_elk.label_line_7": "или поодиночке. Дают",
  "gui.cnc.field_guide_elk.label_line_8": "жёсткую оленину.",
  "gui.cnc.field_guide_elk.label_line_9": "Также любят пшеницу",
  "gui.cnc.field_guide_elk.label_line_10": "",
  "gui.cnc.field_guide_elk.label_line_11": "",
  "gui.cnc.field_guide_elk.label_line_12": "",
  "gui.cnc.field_guide_elk.label_line_13": "",
  "gui.cnc.field_guide_giant_boar.label_line_1": "Гигантские кабаны",
  "gui.cnc.field_guide_giant_boar.label_line_2": "живут в лесах и",
  "gui.cnc.field_guide_giant_boar.label_line_3": "холодных биомах",
  "gui.cnc.field_guide_giant_boar.label_line_4": "небольшими группами.",
  "gui.cnc.field_guide_giant_boar.label_line_5": "При сближении очень",
  "gui.cnc.field_guide_giant_boar.label_line_6": "агрессивны. Их бивни",
  "gui.cnc.field_guide_giant_boar.label_line_7": "годятся для хорошего",
  "gui.cnc.field_guide_giant_boar.label_line_8": "оружия. Ещё кабаны",
  "gui.cnc.field_guide_giant_boar.label_line_9": "ищут и едят красные",
  "gui.cnc.field_guide_giant_boar.label_line_10": "и коричневые грибы",
  "gui.cnc.field_guide_giant_boar.label_line_11": "",
  "gui.cnc.field_guide_giant_boar.label_line_12": "",
  "gui.cnc.field_guide_giant_boar.label_line_13": "",
  "gui.cnc.field_guide_goose.label_line_1": "Гуси живут во",
  "gui.cnc.field_guide_goose.label_line_2": "влажных биомах.",
  "gui.cnc.field_guide_goose.label_line_3": "Кажутся",
  "gui.cnc.field_guide_goose.label_line_4": "дружелюбными, но не",
  "gui.cnc.field_guide_goose.label_line_5": "злите их: эти птицы",
  "gui.cnc.field_guide_goose.label_line_6": "мстительны. Обычно",
  "gui.cnc.field_guide_goose.label_line_7": "любят ламинарию",
  "gui.cnc.field_guide_greywolf.label_line_1": "Лесные волки живут в",
  "gui.cnc.field_guide_greywolf.label_line_2": "лесах и охотятся",
  "gui.cnc.field_guide_greywolf.label_line_3": "стаями на вапити и",
  "gui.cnc.field_guide_greywolf.label_line_4": "белохвостых оленей.",
  "gui.cnc.field_guide_greywolf.label_line_5": "Также любят",
  "gui.cnc.field_guide_greywolf.label_line_6": "перекусить гнилой",
  "gui.cnc.field_guide_greywolf.label_line_7": "плотью",
  "gui.cnc.field_guide_greywolf.label_line_8": "",
  "gui.cnc.field_guide_howler.label_line_1": "Ревуны охотятся во",
  "gui.cnc.field_guide_howler.label_line_2": "влажных лесах. Их",
  "gui.cnc.field_guide_howler.label_line_3": "вой пробирает до",
