#version 430 core

layout(local_size_x = 4, local_size_y = 4, local_size_z = 4) in;
layout(rgba16f, binding = 0) writeonly uniform image3D Destination;
uniform sampler3D Occupancy;
uniform sampler3D Orientation;
uniform sampler3D Emission;
uniform sampler3D Source;
uniform ivec3 ClipMinimum;
uniform int Resolution;
uniform int Operation;
uniform int SourceMip;
uniform float VoxelSize;
uniform vec3 TowardsSun;
uniform vec3 SunRadiance;
uniform int LocalCount;
uniform vec4 LocalPosition[12];
uniform vec4 LocalRadiance[12];
uniform float ColorBleed;
uniform int EmissiveBounce;

const ivec3 DIRECTIONS[6] = ivec3[](
        ivec3(1, 0, 0), ivec3(-1, 0, 0), ivec3(0, 1, 0),
        ivec3(0, -1, 0), ivec3(0, 0, 1), ivec3(0, 0, -1));

ivec3 tile(int face) {
    return ivec3(face & 1, (face >> 1) & 1, (face >> 2) & 1);
}

bool contains(ivec3 cell) {
    return all(greaterThanEqual(cell, ivec3(0))) && all(lessThan(cell, ivec3(Resolution)));
}

ivec3 physical(ivec3 cell) {
    return ((cell + ClipMinimum) % Resolution + Resolution) % Resolution;
}

vec4 occupancyAt(ivec3 cell) {
    return texelFetch(Occupancy, physical(cell), 0);
}

vec3 diffuseAlbedo(vec3 color) {
    float luma = dot(color, vec3(0.2126, 0.7152, 0.0722));
    return clamp(mix(vec3(luma), color, ColorBleed), 0.0, 0.95);
}

float visible(vec3 point, vec3 direction, float distanceToLight) {
    float visibility = 1.0;
    for (int sampleIndex = 0; sampleIndex < 32; ++sampleIndex) {
        float travel = 0.75 + float(sampleIndex) * 0.88;
        if (travel >= distanceToLight) break;
        ivec3 cell = ivec3(floor(point + direction * travel));
        if (!contains(cell)) break;
        float blocker = occupancyAt(cell).a;
        visibility *= 1.0 - blocker * 0.92;
        if (visibility < 0.012) return 0.0;
    }
    return visibility;
}

vec3 direct(vec3 center, vec3 normal, float sky) {
    vec3 position = center + normal * 0.72;
    float sunFacing = max(0.0, dot(normal, TowardsSun));
    vec3 value = vec3(0.0);
    if (sunFacing > 0.0 && sky > 0.0) {
        value += SunRadiance * (sunFacing * sky * visible(position, TowardsSun, 30.0));
    }
    for (int index = 0; index < LocalCount; ++index) {
        vec3 delta = LocalPosition[index].xyz - position;
        float cellDistance = length(delta);
        float worldDistance = cellDistance * VoxelSize;
        float range = LocalPosition[index].w;
        if (worldDistance >= range || cellDistance <= 0.01) continue;
        vec3 direction = delta / cellDistance;
        float cosine = max(0.0, dot(normal, direction));
        if (cosine <= 0.0) continue;
        float smoothCutoff = pow(1.0 - worldDistance / range, 2.0);
        float falloff = smoothCutoff / (1.0 + worldDistance * worldDistance * 0.18);
        value += LocalRadiance[index].rgb * LocalRadiance[index].a * cosine
                * falloff * visible(position, direction, max(0.0, cellDistance - 1.2));
    }
    return min(value, vec3(6.0));
}

vec3 incomingSecondBounce(ivec3 cell, vec3 normal) {
    vec3 total = vec3(0.0);
    float totalWeight = 0.0;
    for (int face = 0; face < 6; ++face) {
        ivec3 direction = DIRECTIONS[face];
        float weight = max(0.0, dot(normal, vec3(direction)));
        if (weight <= 0.0) continue;
        vec3 contribution = vec3(0.0);
        float transmission = 1.0;
        for (int distance = 2; distance <= 8; ++distance) {
            ivec3 neighbor = cell + direction * distance;
            if (!contains(neighbor) || transmission <= 0.02) break;
            vec4 source = texelFetch(Source, neighbor + tile(face ^ 1) * Resolution, 0);
            contribution += source.rgb * transmission / (1.0 + 0.24 * float(distance * distance));
            transmission *= 1.0 - source.a;
        }
        total += contribution * weight;
        totalWeight += weight;
    }
    return total / max(1.0, totalWeight);
}

void base(ivec3 cell) {
    vec4 material = occupancyAt(cell);
    vec4 orientation = texelFetch(Orientation, physical(cell), 0);
    vec4 emission = texelFetch(Emission, physical(cell), 0);
    vec3 normal = orientation.rgb * 2.0 - 1.0;
    float normalLength = length(normal);
    normal = normalLength > 0.04 ? normal / normalLength : vec3(0.0);
    vec3 irradiance = vec3(0.0);
    if (emission.a > 0.0 && normalLength > 0.04) {
        irradiance = Operation == 0 ? direct(vec3(cell) + 0.5, normal, orientation.a)
                : incomingSecondBounce(cell, normal);
    }
    float response = Operation == 0 ? 0.52 : 0.29;
    vec3 diffuse = min(vec3(3.0), irradiance * diffuseAlbedo(material.rgb) * response);
    vec3 emitted = EmissiveBounce != 0 ? emission.rgb : vec3(0.0);
    for (int face = 0; face < 6; ++face) {
        ivec3 coordinate = cell + tile(face) * Resolution;
        float lobe = max(0.0, dot(normal, vec3(DIRECTIONS[face])));
        vec3 bounced = diffuse * lobe * material.a;
        vec3 radiance = Operation == 0 ? bounced + emitted * material.a
                : texelFetch(Source, coordinate, 0).rgb + min(vec3(0.75), bounced);
        imageStore(Destination, coordinate, vec4(radiance, material.a));
    }
}

vec4 over(vec4 front, vec4 back) {
    return front + back * (1.0 - front.a);
}

void mip(ivec3 cell, int size) {
    int inputSize = size * 2;
    for (int face = 0; face < 6; ++face) {
        int axis = face / 2;
        int front = (face & 1) == 0 ? 1 : 0;
        ivec3 sourceTile = tile(face) * inputSize;
        vec4 combined = vec4(0.0);
        for (int y = 0; y < 2; ++y) {
            for (int x = 0; x < 2; ++x) {
                ivec3 p = cell * 2;
                p[(axis + 1) % 3] += x;
                p[(axis + 2) % 3] += y;
                p[axis] += front;
                ivec3 back = p;
                back[axis] += front == 1 ? -1 : 1;
                combined += over(texelFetch(Source, sourceTile + p, SourceMip),
                        texelFetch(Source, sourceTile + back, SourceMip));
            }
        }
        imageStore(Destination, cell + tile(face) * size, combined * 0.25);
    }
}

void main() {
    ivec3 cell = ivec3(gl_GlobalInvocationID.xyz);
    int size = Operation == 2 ? Resolution >> (SourceMip + 1) : Resolution;
    if (any(greaterThanEqual(cell, ivec3(size)))) return;
    if (Operation == 2) mip(cell, size);
    else base(cell);
}
