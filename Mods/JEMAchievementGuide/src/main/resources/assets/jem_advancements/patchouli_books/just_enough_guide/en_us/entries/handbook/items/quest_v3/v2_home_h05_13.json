  "pages": [
    {
      "type": "patchouli:text",
      "title": "Any Excuse Will Do",
      "text": "Place three festive decorations from the listed set."
    },
    {
      "type": "patchouli:text",
      "title": "Any Excuse Will Do",
      "text": "Give an ordinary room a reason to celebrate."
    },
    {
      "type": "patchouli:text",
      "title": "Getting started",
      "text": "Choose decorations with available recipes. Any three placements count; no calendar date or other player is required."
    },
    {
      "type": "patchouli:text",
      "title": "How to use it",
      "text": "Combine magenta dye with an emerald. Create Holidays Gems used by the mod's decorative recipes."
    },
    {
      "type": "patchouli:text",
      "title": "How to use it",
      "text": "Combine a Holidays Gem with the materials required by a chosen decoration. Obtain survival-accessible holiday models; some secondary recipes reuse existing decorations."
    }
  ]
