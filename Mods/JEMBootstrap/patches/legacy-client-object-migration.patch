+			if (!Files.isRegularFile(source, LinkOption.NOFOLLOW_LINKS) || Files.isSymbolicLink(source)) continue;
+			long size = Files.size(source);
+			if (!FileIntegrity.matches(source, size, hash)) throw new IOException("Legacy AutoModpack object fails its hash check: " + hash);
