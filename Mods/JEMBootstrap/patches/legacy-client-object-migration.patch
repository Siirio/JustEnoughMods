+	private static void migrateLegacyObjects(Path targetRoot) throws IOException {
+		Path marker = targetRoot.resolve(OBJECT_MARKER);
+		if (Files.isRegularFile(marker, LinkOption.NOFOLLOW_LINKS) && !Files.isSymbolicLink(marker)) return;
+		Path legacyObjects = PlatformUtils.userDataDirectory().resolve("automodpack").resolve("data").resolve("objects").toAbsolutePath().normalize();
+		if (!Files.isDirectory(legacyObjects, LinkOption.NOFOLLOW_LINKS) || Files.isSymbolicLink(legacyObjects)) {
+			DurableFiles.writeAtomic(marker, "no legacy object store\n".getBytes(StandardCharsets.UTF_8));
+			return;
+		}
+		Set<String> referenced = new HashSet<>();
+		try (Stream<Path> walked = Files.walk(targetRoot)) {
