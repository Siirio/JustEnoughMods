+				var matcher = SHA1.matcher(Files.readString(state, StandardCharsets.UTF_8));
+				while (matcher.find()) referenced.add(matcher.group().toLowerCase(java.util.Locale.ROOT));
+			}
+		}
+		Path targetObjects = targetRoot.resolve("objects").normalize();
+		long imported = 0;
