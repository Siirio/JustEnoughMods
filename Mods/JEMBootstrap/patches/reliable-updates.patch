+package pl.skidam.automodpack_core.update;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.LinkOption;
+import java.nio.file.Path;
+import java.util.List;
+
+import pl.skidam.automodpack_core.config.ClientStorageJsons;
+import pl.skidam.automodpack_core.config.ConfigTools;
+import pl.skidam.automodpack_core.config.GenerationJsons;
+import pl.skidam.automodpack_core.modpack.generation.ContentTree;
+import pl.skidam.automodpack_core.modpack.generation.Journal;
+import pl.skidam.automodpack_core.modpack.generation.JournalEntry;
+import pl.skidam.automodpack_core.storage.SharedObjectOwnership;
+import pl.skidam.automodpack_core.storage.StoragePaths;
+import pl.skidam.automodpack_core.utils.HashUtils;
+
+/** The committed generation cannot depend on a mutable server-journal mirror. */
+final class InstalledGenerationWitness {
+    private InstalledGenerationWitness() { }
+
+    static JournalEntry active(ClientStorage storage, ClientStorageJsons.ClientGenerationStateFields state) throws IOException {
+        if (state.generationWitness != null) {
+            JournalEntry entry = JournalEntry.fromFields(state.generationWitness);
+            validate(storage, state, entry);
+            return entry;
+        }
+        JournalEntry entry = find(storage, state, new JournalMirror(storage).entries(state.modpackId));
+        if (entry != null) return entry;
+        // Migration only: another native instance's journal may still witness the lost branch.
+        // It grants no consent and contributes no ledger, credentials, current head or executable bytes.
+        for (Path peer : SharedObjectOwnership.clientOwnerPaths(storage.dataLocation())) {
+            if (peer.equals(storage.gameDirectory())) continue;
+            Path journal = peer.resolve(StoragePaths.CLIENT_HISTORY_DIR).resolve(state.modpackId).resolve("journal.jsonl");
+            if (!Files.isRegularFile(journal, LinkOption.NOFOLLOW_LINKS) || Files.isSymbolicLink(journal)) continue;
+            try {
+                var peerState = ConfigTools.readUnique(peer.resolve(StoragePaths.CLIENT_ACTIVE_STATE_FILE),
+                        ClientStorageJsons.ClientGenerationStateFields.class, "Peer active state", ClientStorage::validatedActiveState).orElse(null);
+                if (peerState == null || !state.modpackId.equals(peerState.modpackId) || !state.contentToken.equals(peerState.contentToken)
+                        || !state.ownershipLedger.digest.equals(peerState.ownershipLedger.digest)) continue;
+                if (peerState.generationWitness != null) {
+                    entry = JournalEntry.fromFields(peerState.generationWitness);
+                    validate(storage, state, entry);
+                    return entry;
+                }
+                var head = ConfigTools.read(journal.resolveSibling("head.json"), GenerationJsons.HeadDocumentFields.class).orElse(null);
+                if (head == null || !state.contentToken.equals(head.contentToken) || head.ownershipLedger == null
+                        || !state.ownershipLedger.digest.equals(head.ownershipLedger.digest)) continue;
+                for (JournalEntry witnessed : Journal.openComplete(journal).entries()) {
+                    if (!state.contentToken.equals(witnessed.contentToken()) || !head.policySha1.equals(witnessed.policySha1())) continue;
+                    validate(storage, state, witnessed);
+                    return witnessed;
+                }
+            } catch (IOException | RuntimeException invalidPeer) {
+                pl.skidam.automodpack_core.Constants.LOGGER.debug("Peer journal cannot witness an installed generation: {}", journal, invalidPeer);
+            }
+        }
+        throw new IOException("No verified installed-generation witness for " + state.contentToken + ": " + state.modpackId);
+    }
+
+    static JournalEntry forCommit(ClientStorage storage, ClientStorageJsons.ClientGenerationStateFields state) throws IOException {
+        JournalEntry entry = find(storage, state, new JournalMirror(storage).entries(state.modpackId));
+        if (entry == null) throw new IOException("Committed generation has no verified journal entry: " + state.contentToken);
+        return entry;
+    }
+
+    private static JournalEntry find(ClientStorage storage, ClientStorageJsons.ClientGenerationStateFields state, List<JournalEntry> entries) throws IOException {
+        JournalEntry found = null;
+        for (JournalEntry entry : entries) {
+            if (!state.contentToken.equals(entry.contentToken())) continue;
+            if (!Files.isRegularFile(storage.objectFile(entry.policySha1()), LinkOption.NOFOLLOW_LINKS)) continue;
+            validate(storage, state, entry);
+            found = entry;
+        }
+        return found;
+    }
+
+    private static void validate(ClientStorage storage, ClientStorageJsons.ClientGenerationStateFields state, JournalEntry entry) throws IOException {
+        Path policy = storage.objectFile(entry.policySha1());
+        if (!state.contentToken.equals(entry.contentToken()) || Files.isSymbolicLink(policy)
+                || !Files.isRegularFile(policy, LinkOption.NOFOLLOW_LINKS)
+                || !HashUtils.sha1(Files.readAllBytes(policy)).equals(entry.policySha1()))
+            throw new IOException("Installed generation witness fails its identity/hash check: " + state.contentToken);
+        var manifest = new ClientGenerationStore(storage).policyDocument(entry.policySha1());
+        if (!state.modpackId.equals(manifest.modpackId()) || !state.contentToken.equals(ContentTree.tokenOf(manifest)))
+            throw new IOException("Installed policy does not describe the committed generation: " + state.contentToken);
+    }
+}
