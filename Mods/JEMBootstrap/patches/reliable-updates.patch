+package pl.skidam.automodpack.client.ui.screen;
+
+import java.util.ArrayList;
+import java.util.List;
+import java.util.Objects;
+import net.minecraft.ChatFormatting;
+import net.minecraft.client.gui.components.AbstractWidget;
+import net.minecraft.client.gui.screens.Screen;
+import net.minecraft.network.chat.MutableComponent;
+import pl.skidam.automodpack.client.ScreenImpl;
+import pl.skidam.automodpack.client.ui.TextColors;
+import pl.skidam.automodpack.client.ui.versioned.VersionedMatrices;
+import pl.skidam.automodpack.client.ui.versioned.VersionedScreen;
+import pl.skidam.automodpack.client.ui.versioned.VersionedText;
+import pl.skidam.automodpack.client.ui.widget.CheckboxWidget;
+import pl.skidam.automodpack_core.screen.PreviewPayload;
+import pl.skidam.automodpack_core.screen.ReviewActions;
+import pl.skidam.automodpack_core.screen.ReviewPayload;
+import pl.skidam.automodpack_core.screen.ScreenManager;
+import pl.skidam.automodpack_core.utils.ActionAreaLayout;
+
+/** One explicit consent for the selected native update; integrity and trust remain engine-owned. */
+public final class PackConfirmScreen extends VersionedScreen {
+    private static final int BODY = 420;
+    private final ReviewPayload welcome;
+    private final PreviewPayload later;
+    private final ReviewActions actions;
+    private final Screen parent;
+    private boolean acknowledged;
+    private boolean finished;
+    private AbstractWidget downloadButton;
+
+    public PackConfirmScreen(ReviewPayload payload) {
+        super(VersionedText.text("jem.bootstrap.files"));
+        welcome = Objects.requireNonNull(payload);
+        later = null;
+        actions = payload.actions();
+        parent = null;
+    }
+
+    public PackConfirmScreen(Screen parent, PreviewPayload payload) {
+        super(VersionedText.text("jem.bootstrap.files"));
+        welcome = null;
+        later = Objects.requireNonNull(payload);
+        actions = Objects.requireNonNull(payload.actions());
+        this.parent = parent;
+    }
+
+    @Override
+    protected void init() {
+        super.init();
+        ActionDefinition download = primaryAction(VersionedText.text("jem.bootstrap.download"), button -> confirm());
+        ActionRow row = actionRow(ActionAreaLayout.RowKind.FOOTER, download);
+        addActionArea(ActionAreaLayout.FOOTER_RAIL, height - 28, row);
+        downloadButton = download.widget();
+        downloadButton.active = acknowledged && !finished;
+        int bottom = actionAreaTop(ActionAreaLayout.FOOTER_RAIL, height - 28, row);
+        CheckboxWidget consent = new CheckboxWidget(font, 0, 0, panelWidth(BODY),
+                VersionedText.text("jem.bootstrap.consent"), acknowledged, value -> {
+                    acknowledged = value;
+                    downloadButton.active = value && !finished;
+                });
+        consent.moveTo(panelLeft(BODY), bottom - consent.boxHeight() - 8);
+        addRenderableWidget(consent);
+        int wrapWidth = Math.max(1, panelWidth(BODY) - 8);
+        List<MutableComponent> lines = new ArrayList<>();
+        if (welcome != null) {
+            welcome.target().flatTarget().list.stream().sorted(java.util.Comparator.comparing(file -> file.file))
+                    .forEach(file -> lines.addAll(wrapParagraph(font, file.file, wrapWidth)));
+            welcome.firstInstallLocalModPaths().stream().sorted().forEach(path ->
+                    lines.addAll(wrapParagraph(font, VersionedText.str("jem.bootstrap.remove") + " " + path, wrapWidth)));
+        } else {
+            for (var change : later.preview().changeSet().changes()) {
+                lines.addAll(wrapParagraph(font, (change.kind() == pl.skidam.automodpack_core.change.ChangeSet.Kind.REMOVED
+                        ? VersionedText.str("jem.bootstrap.remove") + " " : "") + change.logicalPath(), wrapWidth));
+            }
+        }
+        addCenteredScrollBody(BODY, 40, consent.yPosition() - 8, lines);
+    }
+
+    private void confirm() {
+        // Only the first-install welcome owns WAITING; prepared previews own their native session approval.
+        if (finished || !acknowledged || welcome != null && !actions.reviewActive().getAsBoolean()
+                || actions.cancelledByPlayer().getAsBoolean()) return;
+        finished = true;
+        downloadButton.active = false;
+        ScreenManager.waiting(actions.cancelFromPlayer());
+        if (welcome != null) {
+            actions.setFirstInstallLocalModCleanup().accept(true);
+            actions.startConfirmedUpdate().run();
+        } else {
+            later.continueAction().run();
+        }
+    }
+
+    private void cancel() {
+        if (finished) return;
+        finished = true;
+        if (welcome != null) {
+            actions.cancelConfirmation().run();
+            ScreenImpl.multiplayer();
+        } else {
+            later.cancelAction().run();
+            ScreenImpl.setScreen(parent);
+        }
+    }
+
+    @Override
+    public void tick() {
+        super.tick();
+        if (actions.reviewCancelled().getAsBoolean()) {
+            finished = true;
+            ScreenImpl.multiplayer();
+        } else if (finished && actions.reviewActive().getAsBoolean()
+                && !actions.cancelledByPlayer().getAsBoolean()) {
+            finished = false;
+            if (downloadButton != null) downloadButton.active = acknowledged;
+        }
+    }
+
+    @Override
+    public void versionedRender(VersionedMatrices matrices, int mouseX, int mouseY, float delta) {
+        drawCenteredTextWithShadow(matrices, font, VersionedText.text("jem.bootstrap.files")
+                .withStyle(ChatFormatting.WHITE), width / 2, 16, TextColors.WHITE);
+    }
+
+    @Override
+    public boolean shouldCloseOnEsc() {
+        return handleBackOnEscape(this::cancel);
+    }
+}
