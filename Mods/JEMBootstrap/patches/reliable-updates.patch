-			if (entries.isEmpty()) continue;
-			for (JournalEntry entry : entries) kept.optional(entry.policySha1(), -1, "kept policy document");
-			JournalEntry newest = entries.get(entries.size() - 1);
-			retainGenerationContent(newest, kept);
