+package pl.skidam.automodpack_core.modpack.group;
+
+import static pl.skidam.automodpack_core.Constants.LOGGER;
+import static pl.skidam.automodpack_core.Constants.THIS_MOD_JAR;
+
+import java.io.IOException;
+import java.nio.file.Files;
+import java.nio.file.Path;
+import java.util.jar.JarFile;
+import java.util.jar.Manifest;
+
+import pl.skidam.automodpack_core.utils.JarUtils;
+
+/** Build-time client distribution profile; absent or unreadable metadata always preserves the native full target. */
+final class ClientDistributionProfile {
+	private static final String SKIP_SHADERS_ATTRIBUTE = "JEM-Skip-Shaders";
+	private static final boolean SKIP_SHADERS = skipShaders();
+
+	private ClientDistributionProfile() {}
+
+	static boolean includes(String logicalPath) {
+		if (!SKIP_SHADERS || logicalPath == null) return true;
+		String normalized = logicalPath.replace('\\', '/');
+		return !normalized.equals("shaderpacks") && !normalized.startsWith("shaderpacks/");
+	}
+
+	private static boolean skipShaders() {
+		Path archive = THIS_MOD_JAR;
+		if (archive == null) {
+			try {
+				archive = JarUtils.getJarPath(ClientDistributionProfile.class);
+			} catch (RuntimeException e) {
+				LOGGER.warn("Cannot locate the bootstrap distribution profile; retaining the full client target", e);
+				return false;
+			}
+		}
+		if (!Files.isRegularFile(archive)) return false;
+		try (JarFile jar = new JarFile(archive.toFile())) {
+			Manifest manifest = jar.getManifest();
+			boolean skip = manifest != null && Boolean.parseBoolean(manifest.getMainAttributes().getValue(SKIP_SHADERS_ATTRIBUTE));
+			if (skip) LOGGER.info("Client distribution profile excludes shaderpacks/** from acquisition and projection");
+			return skip;
+		} catch (IOException | RuntimeException e) {
+			LOGGER.warn("Cannot read the bootstrap distribution profile; retaining the full client target", e);
+			return false;
+		}
+	}
+}
