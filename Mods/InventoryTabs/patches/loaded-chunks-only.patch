diff --git a/src/main/java/com/kqp/inventorytabs/tabs/provider/LoadedEntityTabProvider.java b/src/main/java/com/kqp/inventorytabs/tabs/provider/LoadedEntityTabProvider.java
new file mode 100644
index 0000000..29bcc20
--- /dev/null
+++ b/src/main/java/com/kqp/inventorytabs/tabs/provider/LoadedEntityTabProvider.java
@@ -0,0 +1,43 @@
+package com.kqp.inventorytabs.tabs.provider;
+
+import com.kqp.inventorytabs.tabs.tab.RidableInventoryTab;
+import com.kqp.inventorytabs.tabs.tab.SimpleEntityTab;
+import com.kqp.inventorytabs.tabs.tab.Tab;
+import com.kqp.inventorytabs.tabs.tab.VillagerTab;
+
+import net.minecraft.world.Container;
+import net.minecraft.world.ContainerListener;
+import net.minecraft.world.entity.Entity;
+import net.minecraft.world.entity.animal.allay.Allay;
+import net.minecraft.world.entity.animal.horse.AbstractHorse;
+import net.minecraft.world.entity.monster.piglin.Piglin;
+import net.minecraft.world.entity.npc.InventoryCarrier;
+import net.minecraft.world.entity.npc.Villager;
+import net.minecraft.world.entity.vehicle.ChestBoat;
+
+/**
+ * Discovers entity inventory tabs from actual nearby client entities. This
+ * avoids constructing every registered entity type in a synthetic level
+ * during login, where third-party constructors can request unavailable chunks.
+ */
+public class LoadedEntityTabProvider extends EntityTabProvider {
+    @Override
+    public boolean matches(Entity entity) {
+        return !(entity instanceof Piglin)
+                && !(entity instanceof Allay)
+                && (entity instanceof Container
+                        || entity instanceof InventoryCarrier
+                        || entity instanceof ContainerListener);
+    }
+
+    @Override
+    public Tab createTab(Entity entity) {
+        if (entity instanceof Villager) {
+            return new VillagerTab(entity);
+        }
+        if (entity instanceof AbstractHorse || entity instanceof ChestBoat) {
+            return new RidableInventoryTab(entity);
+        }
+        return new SimpleEntityTab(entity);
+    }
+}
