{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jem-atlas-external-web-mechanics-v1",
  "title": "Non-canonical native mod mechanics from reviewed external sources",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mod_id", "installed_version", "pack_snapshot_sha", "researched_on", "data_class", "sources", "observations"],
  "properties": {
    "schema_version": {"const": 1},
    "mod_id": {"type": "string", "pattern": "^[a-z0-9_]+$"},
    "installed_version": {"type": "string", "minLength": 1},
    "packaged_versions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pack_snapshot_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "researched_on": {"type": "string", "format": "date"},
    "data_class": {"const": "external_native_mechanics_evidence_not_canonical_gameplay"},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "observations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/observation"}}
  },
  "$defs": {
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "url", "publisher", "scope", "reviewed_on"],
      "allOf": [
        {"if": {"properties": {"scope": {"const": "installed_static"}}}, "then": {"required": ["artifact_evidence"]}},
        {"if": {"properties": {"scope": {"enum": ["youtube_transcript", "youtube_description"]}}}, "then": {"required": ["video_evidence"]}},
        {"if": {"properties": {"scope": {"const": "youtube_transcript"}}}, "then": {"properties": {"video_evidence": {"required": ["transcript_sha256"], "properties": {"caption_kind": {"enum": ["manual", "automatic"]}}}}}},
        {"if": {"properties": {"scope": {"const": "youtube_description"}}}, "then": {"properties": {"video_evidence": {"properties": {"caption_kind": {"const": "description_only"}}}}}}
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publisher": {"type": "string", "minLength": 1},
        "scope": {"enum": ["project_page", "installed_release", "historical_release", "historical_wiki", "community_wiki", "installed_static", "source_code", "youtube_transcript", "youtube_description"]},
        "artifact_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["path", "sha256", "resource"],
          "properties": {
            "path": {"type": "string", "minLength": 1},
            "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
            "resource": {"type": "string", "minLength": 1},
            "resources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
          }
        },
        "video_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["language", "caption_kind", "start_seconds", "end_seconds"],
          "properties": {
            "language": {"type": "string", "minLength": 1},
            "caption_kind": {"enum": ["manual", "automatic", "description_only"]},
            "start_seconds": {"type": "number", "minimum": 0},
            "end_seconds": {"type": "number", "minimum": 0},
            "transcript_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
          }
        },
        "reviewed_on": {"type": "string", "format": "date"}
      }
    },
    "observation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["key", "kind", "title", "player_action", "outcome", "registry_refs", "depends_on", "conditions", "source_ids", "verification", "runtime_verified", "quest_seed"],
      "properties": {
        "key": {"type": "string", "pattern": "^[a-z0-9_]+:[a-z0-9_]+$"},
        "kind": {"enum": ["metadata", "progression", "acquisition", "interaction", "crafting", "combat", "integration", "compatibility", "automation"]},
        "title": {"type": "string", "minLength": 3},
        "player_action": {"type": "string", "minLength": 5},
        "outcome": {"type": "string", "minLength": 5},
        "registry_refs": {"type": "array", "items": {"$ref": "#/$defs/registry_ref"}},
        "depends_on": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "conditions": {"type": "array", "items": {"type": "string"}},
        "source_ids": {"type": "array", "minItems": 1, "items": {"type": "string"}, "uniqueItems": true},
        "verification": {"const": "EXTERNAL_SOURCE_ONLY"},
        "runtime_verified": {"const": false},
        "quest_seed": {"oneOf": [{"type": "null"}, {"type": "object", "additionalProperties": false, "required": ["goal_ru", "detection"], "properties": {"goal_ru": {"type": "string", "minLength": 5}, "detection": {"enum": ["inventory", "custom_criterion", "manual", "not_applicable"]}}}]},
        "review_note": {"type": "string"}
      }
    },
    "registry_ref": {
      "type": "object",
      "additionalProperties": false,
      "required": ["registry", "id"],
      "properties": {
        "registry": {"enum": ["items", "blocks", "entities", "effects", "enchantments", "biomes", "structures", "creative_tabs"]},
        "id": {"type": "string", "pattern": "^[a-z0-9_.-]+:[a-z0-9_./-]+$"}
      }
    }
  }
}
