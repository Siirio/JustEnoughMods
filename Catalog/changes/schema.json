{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "jem-registry-atlas-change-record-v2",
  "title": "JEM Registry Atlas change record",
  "type": "object",
  "required": ["schema_version", "change_id", "status", "selectors", "precedence", "change", "cause", "rationale", "introduced", "history", "impacts"],
  "properties": {
    "schema_version": {"const": 2},
    "change_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]+$"},
    "status": {"enum": ["active", "conditional", "superseded", "removed"]},
    "inherits": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "selectors": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/selector"}},
    "exceptions": {"type": "array", "items": {"$ref": "#/$defs/selector"}},
    "conditions": {"type": "array", "items": {"type": "object"}},
    "precedence": {
      "type": "object",
      "required": ["layer", "priority"],
      "properties": {"layer": {"type": "string"}, "priority": {"type": "integer"}, "overrides": {"type": "array", "items": {"type": "string"}}}
    },
    "change": {
      "type": "object",
      "required": ["summary", "modifiers"],
      "properties": {
        "summary": {"type": "string"},
        "modifiers": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/modifier"}}
      }
    },
    "cause": {
      "type": "object",
      "required": ["owner", "kind", "source_files"],
      "properties": {"owner": {"type": "string"}, "kind": {"type": "string"}, "source_files": {"type": "array", "minItems": 1, "items": {"type": "string"}}}
    },
    "rationale": {"type": "object", "required": ["purpose", "decision_source"]},
    "introduced": {"$ref": "#/$defs/history"},
    "history": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/history"}},
    "impacts": {"type": "object", "required": ["systems", "relations", "notes", "unresolved"]}
  },
  "$defs": {
    "selector": {
      "type": "object",
      "required": ["type", "registry"],
      "properties": {
        "type": {"enum": ["id", "namespace", "registry", "tag", "category", "source_set"]},
        "registry": {"enum": ["items", "blocks", "entities", "effects", "enchantments", "biomes", "structures", "creative_tabs", "*"]},
        "value": {"type": "string"},
        "members_path": {"type": "string"},
        "records_field": {"type": "string"},
        "id_field": {"type": "string"}
      }
    },
    "modifier": {
      "type": "object",
      "required": ["property", "operation", "before", "after"],
      "properties": {
        "property": {"type": "string"},
        "operation": {"enum": ["set", "add", "multiply_base", "multiply_total", "allow", "deny", "replace", "derive", "document"]},
        "before": {},
        "after": {},
        "conditions": {"type": "array"},
        "notes": {"type": "string"}
      }
    },
    "history": {
      "type": "object",
      "required": ["date", "commit", "action", "summary"],
      "properties": {"date": {"type": "string", "format": "date"}, "commit": {"type": ["string", "null"]}, "action": {"type": "string"}, "summary": {"type": "string"}, "source_files": {"type": "array", "items": {"type": "string"}}}
    }
  }
}
