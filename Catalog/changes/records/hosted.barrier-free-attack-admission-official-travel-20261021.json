  "change": {
    "summary": "hosted barrier free attack admission official travel 20261021",
    "modifiers": [
      {
        "property": "hosted.structural_boss_admission_and_barriers",
        "operation": "replace",
        "before": "Structural Fight/Campaign/Raid used visual, collision and teleport containment; proximity prompts and timeout/reload lobby release existed.",
        "after": {
          "boss_barriers": "Remove entirely for structural Boss Fight/Campaign/Raid; preserve Blood Moon/Resource Rush contracts. Structure identity/safe placement/rewards stay canonical.",
          "lobby": "Persist noAI/invulnerability/target/presentation hold across join/reload until canonical Start, no proximity player immunity.",
          "attack": "Cancel attempted dormant-boss hit and open existing GUI with authoritative admission checks, never automatic combat.",
          "raid": "HostedRaidScaling owns preparation boost; Start adds participant scale once without double melee multiplier.",
          "marker_travel": "Native actions only for official server boss/event object identities; server resolves IDs, checks availability/eligibility/safe destination. Personal/home/death native behavior/privacy unchanged.",
          "empty_attempt": "Existing hosted grace closes no-present-participant attempt.",
          "raid_authored_adds": "Authored Raid reinforcements associate with the canonical hosted boss; damage authority resolves through that boss, so outsider damage remains denied.",
          "orphan_recovery": "A closed Raid orphan observed on load returns to a normal dormant held boss; it cannot retain active Raid combat state.",
          "campaign_start": "Canonical hosted Start rechecks Campaign prerequisites; terrain remains freely accessible.",
          "retired_block_cleanup": "Exact retired JEM barrier IDs in known owned shell cells only; no broader old-world migration."
        }
      },
      {
        "property": "player.personal_death_home_routes",
        "operation": "replace",
        "before": "No public /death registration; existing HomeTravel single return.",
        "after": {
          "death": "Up to three latest own UUID-bound records; current ownership and full-box safe arrival revalidation.",
          "home": "Existing personal respawn point; /home all bounded nearby living/ ridden passenger tree preflight with ownership/combat/event gates.",
          "rollback": "Continue each detach/restore/reattach independently; report recovery_required for incomplete native rollback."
        }
      }
    ]
