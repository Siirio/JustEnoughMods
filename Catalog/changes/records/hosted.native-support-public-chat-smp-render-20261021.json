  "change": {
    "summary": "Separate World Tier enrollment from hosted admission; native team support shares canonical boss Start and protection; public OP chat and native previews outside SMP.",
    "modifiers": [
      {
        "property": "encounter.hosting_role",
        "operation": "replace",
        "before": "Every World Tier profile could enter a solo/party lobby, including ordinary Legendary Monsters mobs.",
        "after": "hosted_encounter is independent of scaling/progression; expanded Legendary Monsters mobs remain enrolled but cannot host. Native forge:bosses contains only cloud_golem, the_obliterator and posessed_paladin."
      },
      {
        "property": "encounter.native_support",
        "operation": "replace",
        "before": "Dormancy and Start applied only to one registered living entity; support could be held in independent lobbies.",
        "after": "Paladin ally_tags uses native possessed_armor_team inside the canonical registered structure. Support binds to the canonical live claim, never becomes an independent host, shares hold/Start/failure and participant target/damage gates. Native SoulStrike is an owner-bound ThrowableProjectile, not another boss; native owner resolution pauses its tick while the owner is held."
      },
      {
        "property": "client.gui.player_preview",
        "operation": "replace",
        "before": "Global ScreenEvent scope, native Quick Skin override and direct custom race-preview calls.",
        "after": "Custom PlayerRenderer interception only in SmpScreen; Quick Skin override removed; race previews use native renderers."
      },
      {
        "property": "server.chat.default",
        "operation": "replace",
        "before": "ServerLogin 1.0.3 rerouted OP2 default messages into 100-block same-dimension system chat.",
        "after": "Exact-version dedicated adapter returns false from handleDefaultChat after the unchanged LoginEvents authentication checks; vanilla public chat retains sender identity. Explicit admin commands are unchanged."
      }
    ]
  },
