  "change": {
    "summary": "Use logical-server non-event services and explicit dedicated-host event activation; absent/off domains hide only unavailable native features.",
    "modifiers": [
      {
        "property": "server.hosted_feature_activation",
        "operation": "replace",
        "before": "Physical dedicated gating mixed non-event support with scheduled events",
        "after": {
          "non_event": "Logical-server SMP/profile/party/home/travel/native optional support in integrated/dedicated worlds; per-domain primitive/NBT adapters",
          "events": "Only dedicated&&host-enabled; ordinary solo Raid rows separately admitted by EventRuntime.available",
          "disabled_saved_events": "No active waves/attacks/debuffs/event money/targeting from persisted disabled rows; terrain and inventory recovery/cancellation retained",
          "availability": "Host snapshot exposes economy AVAILABLE/DISABLED_BY_WORLD/UNAVAILABLE_MISSING_CONTENT and feature tabs; Settlements emerald projections need no Economy renderer",
          "escrow": "Existing item recovery stays independent; missing reward owner retains journals and visible state",
          "auth": "Dedicated identity/authentication, native private Xaero state and operator boundaries unchanged"
        }
      }
    ]
  },
