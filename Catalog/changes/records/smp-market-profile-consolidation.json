  "change": {
    "summary": "JEM SMP consolidates its custom Market, Wallet, profiles, navigation, read-only settlement/recruit projections and operator event commands under their canonical server owners.",
    "modifiers": [
      {
        "property": "smp.player_interface",
        "operation": "replace",
        "before": {
          "entry_points": [
            "multiple public economy/death/SMP command branches",
            "claim-owned navigation"
          ],
          "market": "remote read-only bulletin"
        },
        "after": {
          "entry_point": "/smp",
          "market": "server-authorized catalog and transactions",
          "wallet": "balance, transfer and physical exchange",
          "profiles": "privacy-aware owner/public projections",
          "administration": "permission-2 /jem event and /jem boss branches"
        },
        "notes": "Shops remain native Spud ownership; settlements and recruits remain read-only projections; home travel remains /home."
      }
    ]
  },
