  "change": {
    "summary": "Native Recruits charge actual Coin hiring and seven-day per-contract wages; persistent three-missed-period rebellion and paid atomic founding/area expansion reuse canonical owners.",
    "modifiers": [
      {
        "property": "recruits:recruit.settlement_payroll_loyalty",
        "operation": "replace",
        "before": {
          "value": "Town roster/global schedule and earlier missed-period bookkeeping; standalone employers lacked equivalent payroll ownership"
        },
        "after": {
          "period_ticks": 168000,
          "schedule": "Per-contract next payday from actual hire/adoption, monotonically advanced gameTime; frozen roster/amount/generation per period",
          "payment": "Existing Economy town treasury or authenticated employer Wallet",
          "misses": "Actual distinct unpaid-period identities; paying one removes only that miss",
          "rebellion": "Three actual insufficient-funds periods; persists death/chunk/restart/disband; native defeat then paid rehire required",
          "replay": "Stable transfer receipt plus saved contract generation; no double week charge"
        }
      },
      {
        "property": "economy.native_recruit_hire",
        "operation": "replace",
        "before": {
          "value": "Native configured emerald cost/payment and client-supplied Noble terms"
        },
        "after": {
          "value": "Exact installed native cap/Hired cancellation/group/faction behavior retained; server computes configurable rank/level hire Coin cost and performs existing Economy debit before native ownership/spawn; validates Noble list/stock/group/config; failed hire consumes no stock"
        }
      },
      {
        "property": "settlements.founding_cost",
        "operation": "replace",
        "before": {
          "value": "Founding lacked current Coin charge"
        },
        "after": {
          "default_copper": 300,
          "source": "SettlementEconomyConfig",
          "validation": "Name,bell,distance,overlap before payment; no town on failure"
        }
      },
      {
        "property": "jem_economy:coin.settlement_expansion",
        "operation": "replace",
        "before": {
          "value": "Physical marginal-area rule existed; alternate legacy radius path could differ"
        },
        "after": {
          "cost_copper_per_added_block": 1,
          "payment": "Existing exact backed physical Coins",
          "geometry": "Shared bounded rectangular union; no shrink/no-op debit; exact bounds/request receipt binding",
          "deletion": "Outstanding payroll prevents deletion; remaining employment transfers to personal roster preserving payday"
        }
      },
      {
        "property": "settlements.coin_quote_protocol",
        "operation": "replace",
        "before": {
          "version": 3
        },
        "after": {
          "version": 4,
          "value": "Server founding/hire/wage/Noble/workforce/treasury/expansion-rate projections; exact matching client/server JAR; native monetary cells render only"
        }
      }
    ]
  },
