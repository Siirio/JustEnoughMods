  "change": {
    "summary": "Implement shared90 plus personal10 happiness, independent bed/roof/room complaints, occupied-street comfort, native golem/recruit guards, four-page settlement GUI and durable daily resident/comfort taxes.",
    "modifiers": [
      {
        "property": "settlements.personal_happiness",
        "operation": "replace",
        "before": "Legacy50base and daily drift, weighted town20/20/20/15/15/10, additive comfort/animals and social ceiling.",
        "after": "Shared comfort15+safety10+housing20+food20+community15+jobs10, plus personal PatPat10/24000ticks; tax0/3/8/16 once and independent room/light/fear/injury/harmful-food deductions. Precise internal doubles, final round; town is mean ordinary resident happiness."
      },
      {
        "property": "settlements.housing",
        "operation": "replace",
        "before": "Privacy-gated bed45 plus local amenities; room floor required roof.",
        "after": "Bed coverage10 plus roof coverage10, roof over both halves excluding leaves; distinct no-bed/no-roof, one physical bed per resident; room space independently reachable and never zeroed by missing roof. Native private-bed sleep refusal retained without additional happiness penalty."
      },
      {
        "property": "settlements.city_comfort",
        "operation": "replace",
        "before": "Repeated arbitrary decoration registry counts capped citywide.",
        "after": "Four25point components: actual used house-bell paving connectivity; four peaceful animal types; BLOCK8 street/entrance coverage; visible nearby greenery coverage20 plus four kinds5. Bounded resumable observations preserve confirmed values on unload/incompletion."
      },
      {
        "property": "settlements.security",
        "operation": "derive",
        "before": "Native owned stationary recruits only.",
        "after": "Living stationary owned recruits plus native golems; persistent observation identity survives unloading. Newly spawned in-town guards receive numbered localized names only if no manual name; native AI/orders/health retained."
      },
      {
        "property": "settlements.daily_tax",
        "operation": "derive",
        "before": null,
        "after": "24000elapsed-gameTime day: separately averaged resident happiness and satiety multiplied, max1 native currency unit/resident scaled taxRate/15 and observed/day fraction; one town comfort bonus max10 independent of population/rate, proportional daily comfort. Currency-specific fractions persist; intent/receipt/ack persistence prevents duplicate payout. Emeralds vanilla NPC income; coins finite OPERATIONS transfer, shortage stays pending."
      },
      {
        "property": "settlements.gui",
        "operation": "replace",
        "before": "Separate treasury/settings, cramped town framing and scan diagnostics.",
        "after": "Settlement/residents/happiness/chests; town isometry and used-home detail, four comfort categories, compact treasury and tax control, name and confirmed delete; guards include golems, actual HP, resident redundant buttons removed, player-facing conditions."
      }
    ]
  },
