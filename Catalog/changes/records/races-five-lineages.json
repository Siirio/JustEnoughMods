  "change": {
    "summary": "Replace three minor cultural roles with five server-authoritative races, innate signatures and persistent three-tier race progression while keeping professions independent.",
    "modifiers": [
      {
        "property": "jem_roles.race_set",
        "operation": "replace",
        "before": {
          "value": [
            "HUMAN",
            "DWARF",
            "ELF"
          ]
        },
        "after": {
          "value": [
            "ANCESTORS",
            "VOID_WALKERS",
            "BORN_IN_BLOOM",
            "INFECTED_BY_SCULK",
            "NETHER_HEARTEDS"
          ]
        }
      },
      {
        "property": "jem_roles.progression",
        "operation": "replace",
        "before": {
          "value": "small passive traits plus profession and Iron's direct-hit bonuses"
        },
        "after": {
          "value": "exactly five buffs and two debuffs per race, one innate signature and three persistent behavior-changing tiers independent from professions"
        }
      },
      {
        "property": "jem_roles.entrypoints",
        "operation": "replace",
        "before": {
          "value": "direct role/profession commands and SMP chat-command forwarding"
        },
        "after": {
          "value": "bounded SMP module packets opening JEM Races or native Pufferfish Skills"
        }
      },
      {
        "property": "jem_professions.server_definitions",
        "operation": "set",
        "before": {
          "value": "canonical managed-client Paxi datapack absent from ordinary dedicated Server"
        },
        "after": {
          "value": "same complete profession Paxi datapack present on managed client and dedicated Server"
        }
      },
      {
        "property": "jem_roles.protected_target_acquisition",
        "operation": "replace",
        "before": {
          "value": "protected Piglin, End-kin and green-biome acquisition replaced the Forge target with null"
        },
        "after": {
          "value": "protected acquisition cancels LivingChangeTargetEvent and never supplies a null target to Brain behavior"
        }
      },
      {
        "property": "jem_roles.nether_fire_immunity",
        "operation": "replace",
        "before": {
          "value": "tagged fire damage canceled at LivingHurtEvent after client-visible hurt feedback could begin"
        },
        "after": {
          "value": "tagged fire attacks canceled at highest-priority LivingAttackEvent with the later hurt guard retained and residual fire cleared"
        }
      },
      {
        "property": "jem_roles.visual_event_transport",
        "operation": "set",
        "before": {
          "value": "server-spawned generic Heart, Portal, Sculk Soul, Happy Villager and Flame bursts"
        },
        "after": {
          "value": "bounded protocol-3 accepted-transition events drive client-only Lodestone particles and depth-tested world geometry with LOW/MEDIUM/HIGH/ULTRA decorative budgets"
        }
      },
      {
        "property": "jem_roles.activation_validation",
        "operation": "replace",
        "before": {
          "value": "Direct V and native spell V could both dispatch; native completion ignored failed signature and used independent cooldown defaults; utility charge visual could precede readiness."
        },
        "after": {
          "value": "One key owner, server preflight and boolean effect commit; native successful lifecycle only after committed ability; HUD projects RaceRecord remaining ticks; localized failure and no premature utility charge or teleport effects."
        }
      }
    ]
  },
