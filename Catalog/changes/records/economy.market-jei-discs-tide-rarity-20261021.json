  "conditions": [
    {
      "runtime": "Dedicated server gameplay; matching client GUI artifacts. No game launch or automated tests. Player acceptance pending."
    }
  ],
  "precedence": {
    "layer": "jem_shipping_market_repair",
    "priority": 650
  },
  "change": {
    "summary": "Add market JEI links, bounded loading, buy-only music discs and native-rarity Tide fish sales and fishing weights.",
    "modifiers": [
      {
        "property": "market.loading",
        "operation": "replace",
        "before": "Search sent each keystroke; listings sorted and categories reflected repeatedly; item names wrapped each frame; errors hid results.",
        "after": "Debounce search 250ms, one request in flight, retain latest queued search, cache sorted stock/category and wrapped item labels, allow retry after failed transaction; omit listings lacking both available buy and funded sell routes."
      },
      {
        "property": "market.jei",
        "operation": "replace",
        "before": "Displayed market items had no recipe link.",
        "after": "Item card click or R uses the existing JEMServer optional JEI adapter, now public; no second JEI plugin or dependency."
      },
      {
        "property": "economy.music_discs",
        "operation": "replace",
        "before": "Legacy policies could buy back some discs.",
        "after": "All native RecordItem/music_discs are BUY_ONLY, exactly 10000 Copper (1 Arcane) each, no server buyback."
      },
      {
        "property": "economy.tide_fish",
        "operation": "replace",
        "before": "Some native fish omitted; varied prices and native FishLength tags rejected.",
        "after": "101 fish from installed Tide 2.1.1-hotfix native definitions admitted with rarity buyback: common1/uncommon3/rare8/very_rare20/legendary50 Copper. Retain existing purchase eligibility; ensure existing buy prices are at least twice buyback. Only native FishLength finite positive Double and IsBucketable Boolean-byte accepted; no arbitrary NBT or size premium."
      },
      {
        "property": "fishing.selection_weights",
        "operation": "replace",
        "before": "Native selection weights in installed Tide fish definitions.",
        "after": "Dedicated-only required built-in data pack changes only selection_weight: common x0.9/uncommon x1.1/rare x1.25/very_rare x1.5/legendary x1.75; native conditions, rods and selection remain owners. Relative weights are not guaranteed absolute probabilities; integrated singleplayer receives no pack."
      }
    ]
  },
