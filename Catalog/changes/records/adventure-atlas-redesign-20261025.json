  "change": {
    "summary": "Reorganize the existing native book into a central adventure atlas, preserve saved quest contracts and add verified storage and weapon-acquisition objectives",
    "modifiers": [
      {
        "property": "quests.authored_navigation",
        "operation": "replace",
        "before": "Fragmented chapter navigation and repeated stock layout",
        "after": "One ten-category native chapter index, real thematic subchapters, explicit return links and localized captions with six supplied identity images and matching Gemini background extensions"
      },
      {
        "property": "quests.saved_contracts",
        "operation": "set",
        "before": "Existing native quest, task, reward and dependency identities",
        "after": "Existing IDs, task predicates, reward payloads and prerequisites remain. Rearrangement changes chapter membership, coordinates and explanatory presentation without resetting team progress or introducing a second reward owner"
      },
      {
        "property": "quests.verified_additions",
        "operation": "add",
        "before": null,
        "after": "Ten installed backpack/storage item objectives and three native Nightfall weapon-acquisition advancements. No invented Nightfall boss encounters, free legendary weapons or synthetic campaign dependencies"
      }
    ]
  },
