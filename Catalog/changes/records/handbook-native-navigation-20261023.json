  "change": {
    "summary": "native-navigation",
    "modifiers": [
      {
        "property": "handbook.native_book",
        "operation": "document",
        "before": "The generated guide was disabled and the historical custom item could redirect an ordinary vanilla book.",
        "after": {
          "item": "patchouli:guide_book",
          "nbt": {
            "patchouli:book": "jem_advancements:just_enough_guide"
          },
          "recipe": "One minecraft:dirt plus one minecraft:stick in any two crafting-grid slots, native patchouli:shapeless_book_recipe; no ordinary book required.",
          "navigation": "Seven native icon ribbons, RU/EN entry/category aliases, configurable Alt+H, native history and return, no advancement awards."
        }
      },
      {
        "property": "handbook.native_manuals",
        "operation": "document",
        "before": "Native books existed separately.",
        "after": "Eight general native families plus acquired Aquamirae NBT logbooks, preserving native knowledge. Fixed three-route server request protocol1 is read-only and requires the exact handbook."
      },
      {
        "property": "handbook.resource_reload",
        "operation": "document",
        "before": "Search and item-help listeners queried categories/ and entries/ with trailing slashes. Minecraft 1.20.1 rejects these directories before reading resources, aborting initial resource reload.",
        "after": "Query directory roots without a trailing slash and skip exactly the separating slash when deriving relative category/entry IDs. Bilingual search, category ancestry, item selectors and authored resources retain their existing identities."
      },
      {
        "property": "handbook.creative_inventory",
        "operation": "replace",
        "before": "No creative_tab, so Patchouli contributes this book variant only to the native Search tab.",
        "after": "Native minecraft:tools_and_utilities also contains the exact generated handbook variant, making it available to JEI ingredient enumeration and its curated Books consumer."
      }
    ]
  },
