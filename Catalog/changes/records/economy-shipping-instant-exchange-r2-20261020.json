  "change": {
    "summary": "Replace scheduled shipping with immediate owner action; add guarded exchange/withdrawal tab and approved R2 body/native goods/collision integration.",
    "modifiers": [
      {
        "property": "shipping.sale.trigger",
        "operation": "replace",
        "before": "MarketRuntime scheduled new daily sales; existing owner/slots/physical journal.",
        "after": "Only valid current owner sale-tab action starts sellAndCollect: collect previous payout, fresh bounded rational quote, preserve recovery journal phases/fingerprints/provenance, collect new funded physical payout. MarketRuntime refreshes preview/recovery only. IDs,Owner,Instance,54+9 slots and existing contents retain owners."
      },
      {
        "property": "shipping.sale.quote_presentation",
        "operation": "replace",
        "before": "Existing shipping right-side presentation/scheduled preview.",
        "after": "One total, ordinary account/global allowances and localized result; no duplicated per-item list or contextual admission label. Server uses CurrencyCore exact rational prices/family quotas and actual funded reserve. Zero payout leaves goods; legacy journal source route preserved; disagreement quarantines instead of inventing payment."
      },
      {
        "property": "shipping.container.exchange",
        "operation": "replace",
        "before": "No second currency-action tab in the shipping container.",
        "after": "Same owner menu tab1 hides/blocks shipping slot gestures. CurrencyContainerAccess requires current matching valid container/tab; EconomyNetwork validates full-market authority and IdentityPolicy before existing exchangePhysical/withdraw. Bounded denomination/count/amount/request IDs and matching status packet; client does not own money."
      },
      {
        "property": "shipping.presentation.approved_r2",
        "operation": "replace",
        "before": "Earlier block/item presentation; no approved weighing-station native display renderer/body-derived collision.",
        "after": "Approved R2 body JSON/native atlas plus12 authored anchors rendered with actual ItemRenderer FIXED native models:4diamonds,4fish,4oak logs. Decoration adds no inventory/drop authority. Facing rotates body/anchors; ShippingStationShape derives collision/outline from same axis-aligned body cuboids and rejects unsupported body rotations. Shared ShippingBoxLayout owns real slot geometry; accepted native merchant/Market family retained."
      }
    ]
  },
