  "change": {
    "summary": "Economy is one logical-server currency owner with a per-world dormant switch, safe native merchant extensions and exact recipe-generation policy.",
    "modifiers": [
      {
        "property": "economy.currency_owner",
        "operation": "replace",
        "before": {
          "runtime": "Separate jem_currency_core runtime required by Economy/Settlements"
        },
        "after": {
          "runtime": "One JEMEconomy artifact; legacy jem_economy registry IDs, jem_economy save, balances, lots, physical outstanding, receipt/account identities and exact authored price resources preserved"
        }
      },
      {
        "property": "economy.world_enabled",
        "operation": "replace",
        "before": {
          "runtime": "Physical/dedicated boundary and presence-based activation"
        },
        "after": {
          "default": "World SERVER [economy] enabled=true",
          "off": "Currency APIs/mutations, GUI/actions, minting, market/shipping, native Coin conversion and quest money remain dormant without deleting money, coins or journals",
          "api": "EconomyApi.isEnabled(MinecraftServer), isEnabled() gameplay; recipePolicyEnabled() only inside recipe callback",
          "protocol": "jem_economy:wallet version7 includes host feature state"
        }
      },
      {
        "property": "economy.native_offer_ownership",
        "operation": "replace",
        "before": {
          "runtime": "JEM synthetic one-emerald offers/restrictions could alter and serialize native offers"
        },
        "after": {
          "modern": "Original native MerchantOffers and stock remain native; JEM extensions persist separately as JemEconomyExtensionOffersV2 and are projected only while ON",
          "off": "Modern merchants return original native list; client Market/monetary screens invalidate and delayed catalog/open packets are rejected",
          "legacy": "Ambiguous historical mixed offers are preserved and visibly blocked while OFF, never guessed/repriced/reset; ON resumes stored offers"
        }
      },
      {
        "property": "economy.recipe_projection",
        "operation": "replace",
        "before": {
          "runtime": "Recipe callback used physical side or generic live-world query before world config exists"
        },
        "after": {
          "owner": "EconomyRecipePolicy and exact installed KubeJS native reload context",
          "projection": "Per RecipeManager generation and actual nullable script-server owner; no prior-world/global default guess",
          "reconcile": "One native resource reload only for initial/config mismatch after actual world SERVER config loads; fail closed when expected projection missing; gameplay admission held until applied",
          "policy": "Existing exact mincer cobblestone guard applies in integrated/dedicated ON, native recipe preserved OFF/absent"
        }
      }
    ]
  },
