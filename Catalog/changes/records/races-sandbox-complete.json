        "property": "race.leaf_bridge.cooldown_ticks",
        "operation": "set",
        "before": 0,
        "after": 300
      },
      {
        "property": "race.void_projectile.inaccuracy",
        "operation": "set",
        "before": 0.25,
        "after": 0,
        "notes": "Codex implementation choice for deterministic shared live prediction/actual launch. Speed1.5, gravity0.03, air drag0.99, water drag0.8 and native collision remain; safe arrival is server-owned."
      },
      {
        "property": "race.sandbox.signature.tier_effects",
        "operation": "derive",
        "before": "all hardcoded maximum, unrelated to saved progression",
        "after": "Ancestors12/16 radius, tierII cleanse, tierIII absorption; Void24/32 reach and tierIII slow; Bloom preserves approved action-lock/constriction/poison ordering; Sonic baseline12 damage, tierII push/tierIII2s slow; Nether6/8/10 damage and2/4/6s fire with five authored eruptions.",
        "notes": "Canonical progression thresholds reused. Sonic tierII/III and Nether tier scaling are explicitly Codex implementation choices; existing sandbox-approved ability identity remains."
      }
