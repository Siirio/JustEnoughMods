  "change": {
    "summary": "Add a bounded dedicated-server city surface LOD view, sanitize detached block palettes before transmission and restrict storefront search to one server-validated category.",
    "modifiers": [
      {
        "property": "settlements.snapshot.disclosure",
        "operation": "deny",
        "before": "Housing palette includes enclosed nonair states; local cutaway can expose hidden resources",
        "after": "Omit fully enclosed blocks before palette; tagged ores additionally require server eye-ray visibility. Same policy applies to city, housing, filters and tooltips."
      },
      {
        "property": "settlements.city.surface_view",
        "operation": "add",
        "before": null,
        "after": "Owner-authorized max8 cached jobs,128 columns globally/tick,automatic surface LOD up to8192 states,loaded chunks only,200tick refresh; observed comfort samples revalidated; camera/zoom/pan/filter/detail controls."
      },
      {
        "property": "market.search.category",
        "operation": "replace",
        "before": "Global all category plus category dropdown overlays catalog",
        "after": "Exactly blocks/food/plants/resources/drops; server normalizes invalid/global to blocks; persistent category panel search at its bottom,clear/Escape/page reset."
      },
      {
        "property": "currency.coin.visuals",
        "operation": "replace",
        "before": "Fixed round extrusion and previous detailed face sprites",
        "after": "Five original native16x16 layered pixel material exports with distinct silhouettes through vanilla generated item models; IDs/values untouched"
      }
    ]
  },
