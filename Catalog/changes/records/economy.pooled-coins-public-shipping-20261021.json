  "change": {
    "summary": "economy pooled coins public shipping 20261021",
    "modifiers": [
      {
        "property": "economy.bearer_coin_and_terminal_contract",
        "operation": "replace",
        "before": "Operation-specific coin stamps prevented merge; owner-only shipping paid physical output; Buyer and separate wallet routes existed.",
        "after": {
          "coins": "World-local denomination pools, per-operation quantity journal, lazy proven-legacy normalization, partial-stack withdrawal capacity and quantity-based legacy delivery recovery.",
          "shipping": "Public exclusive identity-bound session; account recovery; automation locked during session/transaction; seller ledger payout; five-denomination icon dropdowns, deposit/withdraw/send.",
          "retired": "Buyer creation/trading and standalone wallet UI; retain compatibility registrations and shared native merchants.",
          "quotas": "Remove ordinary daily monetary/family/item quotas and artificial ordinary building stock; keep finite NPC funding, special disc/progression/native-restock and atomic capacity checks.",
          "bulk": "Player inventory is a valid full-order destination; no mandatory personal warehouse."
        }
      },
      {
        "property": "economy.user_price_anchors",
        "operation": "replace",
        "before": {
          "exact_old_values": "See prior source/history; not guessed from rounded UI."
        },
        "after": {
          "sale_per_64_copper": {
            "minecraft:wheat": 10,
            "minecraft:carrot": 8,
            "minecraft:beetroot": 80,
            "minecraft:gold_ingot": 54,
            "minecraft:diamond": 1000
          },
          "fish": "Unchanged",
          "mending_purchase_minimum_copper": 800,
          "starter_copper": 2000,
          "reserve_redistribution": "None",
          "policy": "Exact fractions and owning generator anchors; netherite_ingot sale only, no blanket netherite admission."
        }
      }
