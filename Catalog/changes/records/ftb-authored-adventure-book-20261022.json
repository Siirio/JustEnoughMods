  "change": {
    "summary": "Preserve the native quest/progress/reward contracts while migrating the authored book to seven real thematic canvases under UI Rescue v3",
    "modifiers": [
      {
        "property": "guide.ftb_book",
        "operation": "replace",
        "before": "Seven small universal authored chapters with native per-world projection.",
        "after": {
          "chapters": 7,
          "cards": 602,
          "active_authored": 577,
          "reference_only": 25,
          "choices": 61,
          "tasks": "native item/dimension/advancement/kill where exact; indexed Forge/native-owner custom predicates otherwise",
          "progress": "FTB Teams; distinct collection identity set only in BookCollections",
          "availability": "Native registered targets and every reward are checked before loading; unavailable content becomes informational and cannot affect completion."
        }
      },
      {
        "property": "guide.quest_item_acquisition",
        "operation": "add",
        "before": "No entitlements for the new card IDs.",
        "after": "Exact guaranteed items plus one native choice; personal once-only JEMRewards source key survives FTB team changes. Native claim is reopened on enqueue failure; existing take-only delivery splits stacks and persists issued receipts. No direct ground drops."
      },
      {
        "property": "economy.operation_observation",
        "operation": "add",
        "before": "Committed economy operations had no Guide notification.",
        "after": "Immutable operation event after successful shipping payout, withdrawal, native villager purchase or regular market delivery. Quest bridge observes one-shot flags; ledger, quote, physical coin validation and delivery owners are retained."
      },
      {
        "property": "settlements.mount_collection_read",
        "operation": "add",
        "before": "Mount collection type count was internal.",
        "after": "Read-only public API over the existing authenticated collection; no new roster or progression owner."
      },
      {
        "property": "guide.questbook_presentation",
        "operation": "replace",
        "before": "39 visible chapters and grouped hub links, wide diagonal coordinates, invalid compass texture lookup and a tiny hero relative to decoration",
        "after": {
          "navigation": "Seven real default-group chapters, including native edit mode. Historical archives remain in native progress data but are excluded from marked-book sidebar and first selection",
          "layout": "Compact in-canvas zones and native entry camera initialized from actual panel and theme spacing. Camera-only snapshots preserve per-chapter zoom without altering sidebar state. Explicit native quest navigation retains its target",
          "resources": "Obsolete portal image layer removed, remaining exact image and item-model paths audited",
          "events": "Dedicated-only quests and their reference tiles hidden on integrated/off hosts, native dormant identities retained",
          "acceptance": "NOT VISUALLY VERIFIED, manual Minecraft A-G review pending, original opaque emblems and missing dedicated boss banner remain explicit"
        }
      }
    ]
  },
