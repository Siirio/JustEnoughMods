  "change": {
    "summary": "Emerald settlement authority, optional native Xaero claims/Recruits, Workers retirement and requested race controls.",
    "modifiers": [
      {
        "property": "settlements.currency",
        "operation": "replace",
        "before": "CurrencyCore Coin path also active without full Economy.",
        "after": "Actual jem_economy gates Coins; otherwise emerald inventory, isolated treasury and durable intent journal. Defaults founding300/hire120,200,400,700/weekly20,40,70,120/territory100 per new block. Existing Coin debt and funds remain isolated."
      },
      {
        "property": "settlements.workforce",
        "operation": "replace",
        "before": "Workers compatibility and generated production obligations.",
        "after": "No Workers dependency, adapter, current JAR or default config. Legacy workers inactive and pending goods quarantined. Genuine vanilla professions and optional native recruits determine diversity; no replacement worker entities."
      },
      {
        "property": "settlements.xaero",
        "operation": "replace",
        "before": "Settlement overlay owned by JEM Server client.",
        "after": "Optional Settlements adapter extends native map with unobtrusive bounds and owner drag/native confirmation; authoritative expansion validates terms, overlap, bounds and currency. Native waypoints and controls preserved."
      },
      {
        "property": "races.bloom",
        "operation": "replace",
        "before": "Short grip and native poison rejected by poison-immune mobs.",
        "after": "60tick base root permits attacks; stage1 full action lock; stage2 squeeze; stage3 poison only after release for90ticks. Main damage5.4, squeeze2.7; accepted poison health hits1HP/sec, nonlethal1HP floor. Native poison immunity bypassed, full invulnerability/cancellation/absorption remains native."
      },
      {
        "property": "races.b-controls",
        "operation": "replace",
        "before": "Vanilla Ctrl+B narrator branch; Sculk recovery subtracts25 resonance.",
        "after": "Client narrator chord gate disabled without consuming B input; successful Sculk recovery resets all resonance to0."
      }
    ]
  },
