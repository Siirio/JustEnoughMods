  "change": {
    "summary": "Implement multiple owned settlements, exact-dish resident needs, persistent resident and recruit consequences, and paid Xaero territory expansion.",
    "modifiers": [
      {
        "property": "settlements.account_town_limit",
        "operation": "replace",
        "before": {
          "maximum": 1
        },
        "after": {
          "maximum": "unbounded",
          "selection": "skip only when exactly one"
        }
      },
      {
        "property": "minecraft:bell.settlement_interaction",
        "operation": "replace",
        "before": {
          "right_click": "opened Town Dashboard"
        },
        "after": {
          "place": "offer founding",
          "right_click": "native bell",
          "shift_right_click": "open /smp settlements"
        }
      },
      {
        "property": "minecraft:villager.settlement_food",
        "operation": "replace",
        "before": {
          "positive_vanilla_food": "accepted",
          "monotony": "taste group"
        },
        "after": {
          "positive_vanilla_food": "ignored",
          "positive_modded_food": "recipe/progression-gated including installed Nether/End food namespaces",
          "monotony": "exact item; maximum 10 servings of one item per game day",
          "harmful_food": "negative happiness and negative satiety",
          "display": "red-to-green happiness and satiety bars",
          "craving": "persistent randomized threshold from 10..99; forced below 10",
          "storage_behavior": "native navigation; requested dish first, any valid modded dish fallback; reject capped item before extraction; eat toward 100",
          "starvation": "damage when below 10 and no food",
          "happiness": "active unmet craving, not low satiety alone"
        }
      },
      {
        "property": "minecraft:villager.settlement_damage_happiness",
        "operation": "derive",
        "before": {
          "damage_handler": false,
          "aggregate_refresh": "daily"
        },
        "after": {
          "damage_handler": "all positive actual damage except fall",
          "aggregate_refresh": "immediate after damage"
        }
      },
      {
        "property": "minecraft:villager.settlement_hostility",
        "operation": "allow",
        "before": {
          "low_happiness_combat": false
        },
        "after": {
          "threshold_below": 10,
          "target": "authenticated settlement owner",
          "persistence": "derived from saved mood across owner death and reconnect",
          "recovery_at": 10
        }
      },
      {
        "property": "recruits:recruit.settlement_payroll_loyalty",
        "operation": "allow",
        "before": {
          "missed_payroll": "morale penalty only"
        },
        "after": {
          "period_ticks": 168000,
          "rebellion_after_consecutive_misses": 3,
          "native_owner_removed": true,
          "persistent_former_owner_target": true,
          "recovery": "former owner must defeat nonlethally, then use native Recruits hire flow",
          "old_debt_auto_recovery": false
        }
      },
      {
        "property": "settlements.lifecycle",
        "operation": "allow",
        "before": {
          "dead_rows_retained": true,
          "town_deletion": false
        },
        "after": {
          "dead_registrations_removed": true,
          "owner_confirmed_town_deletion": true,
          "treasury_refund": "owner ledger account",
          "world_entities_and_blocks_deleted": false
        }
      },
      {
        "property": "jem_economy:coin.settlement_expansion",
        "operation": "allow",
        "before": {
          "cost": "one Gold Coin per +16 radius"
        },
        "after": {
          "cost_copper_per_added_block": 1,
          "payment": "exact provenance-backed physical five-denomination value and idempotent"
        }
      },
      {
        "property": "settlements.xaero_boundary",
        "operation": "allow",
        "before": {
          "visible": false
        },
        "after": {
          "visible": "always while native map is open",
          "presentation": "low-alpha area fill plus clear outline",
          "preview": "distinct owner held-LMB exact-block rectangular union fill",
          "confirmation": "localized native Xaero context menu",
          "claims": false
        }
      }
    ]
  },
