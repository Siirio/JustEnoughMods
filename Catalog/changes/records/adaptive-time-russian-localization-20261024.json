  "change": {
    "summary": "Readable short durations and Russian resource completion for installed interfaces/items",
    "modifiers": [
      {
        "property": "presentation.gameplay_duration",
        "operation": "replace",
        "before": "Fractional Minecraft days even for seconds",
        "after": "Below one Minecraft day use seconds/minutes, at or above one day integer Minecraft days with localized plurals and + for remainder. Native saved/network units and actual calendar schedules unchanged"
      },
      {
        "property": "presentation.russian_resource_resolution",
        "operation": "replace",
        "before": "Missing installed RU keys fall back to English despite Russian selection",
        "after": "Exact installed keys supplemented through ru_ru resources, English selection and native UI/personal text preserved"
      },
      {
        "property": "presentation.server_menu_components",
        "operation": "replace",
        "before": "Server title.getString flattened translation before metadata reached client",
        "after": "Bounded serialized title Component resolved at client render, explicit invalid-data message, valid legacy literals only when new field absent. Boss/official marker names and known dimensions use native keys, player names and unknown dimension IDs preserved"
      }
    ]
  },
